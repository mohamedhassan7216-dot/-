<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>صفحة هبوط - كورس البرمجة</title>
    <style>
        /* هنا نكتب الـ CSS لتلوين وتنسيق الصفحة */
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f4f7f6;
            margin: 0;
            padding: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }
        .container {
            background-color: #ffffff;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
            max-width: 450px;
            width: 90%;
            text-align: center;
        }
        h1 {
            color: #2c3e50;
            font-size: 24px;
            margin-bottom: 10px;
        }
        p {
            color: #7f8c8d;
            font-size: 16px;
            line-height: 1.6;
            margin-bottom: 25px;
        }
        .badge {
            background-color: #e74c3c;
            color: white;
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 14px;
            display: inline-block;
            margin-bottom: 15px;
            font-weight: bold;
        }
        input[type="email"] {
            width: 100%;
            padding: 12px;
            margin-bottom: 15px;
            border: 2px solid #bdc3c7;
            border-radius: 8px;
            box-sizing: border-box;
            font-size: 16px;
            text-align: center;
        }
        input[type="email"]:focus {
            border-color: #3498db;
            outline: none;
        }
        button {
            background-color: #2ecc71;
            color: white;
            border: none;
            padding: 14px 20px;
            font-size: 18px;
            font-weight: bold;
            border-radius: 8px;
            width: 100%;
            cursor: pointer;
            transition: background 0.3s ease;
        }
        button:hover {
            background-color: #27ae60;
        }
    </style>
</head>
<body>

    <!-- هنا الـ HTML اللي بيشيل العناصر والنصوص -->
    <div class="container">
        <span class="badge">عرض لفترة محدودة! 🔥</span>
        <h1>احترف البرمجة من الصفر إلى أول وظيفة</h1>
        <p>انضم إلينا اليوم واحصل على خصم 50% على أقوى كورس عملي لتطوير الويب لعام 2026. سجل إيميلك لحجز مكانك الآن.</p>
        
        <!-- نموذج جمع البيانات -->
        <form>
            <input type="email" placeholder="أدخل بريدك الإلكتروني هنا" required>
            <button type="submit">احجز مقعدك مجاناً الآن 🚀</button>
        </form>
    </div>

</body>
</html>
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>صفحة هبوط تفاعلية</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f4f7f6;
            margin: 0;
            padding: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }
        .container {
            background-color: #ffffff;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
            max-width: 450px;
            width: 90%;
            text-align: center;
            transition: all 0.5s ease;
        }
        h1 {
            color: #2c3e50;
            font-size: 24px;
            margin-bottom: 10px;
        }
        p {
            color: #7f8c8d;
            font-size: 16px;
            line-height: 1.6;
            margin-bottom: 25px;
        }
        .badge {
            background-color: #e74c3c;
            color: white;
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 14px;
            display: inline-block;
            margin-bottom: 15px;
            font-weight: bold;
        }
        input[type="email"] {
            width: 100%;
            padding: 12px;
            margin-bottom: 15px;
            border: 2px solid #bdc3c7;
            border-radius: 8px;
            box-sizing: border-box;
            font-size: 16px;
            text-align: center;
        }
        button {
            background-color: #2ecc71;
            color: white;
            border: none;
            padding: 14px 20px;
            font-size: 18px;
            font-weight: bold;
            border-radius: 8px;
            width: 100%;
            cursor: pointer;
            transition: background 0.3s ease;
        }
        button:hover {
            background-color: #27ae60;
        }
        
        /* تصميم رسالة النجاح المخفية في البداية */
        .success-box {
            display: none; /* مخفي تلقائياً */
            animation: fadeIn 0.6s ease forwards;
        }
        .success-box h2 {
            color: #2ecc71;
            font-size: 26px;
            margin-bottom: 10px;
        }
        .success-icon {
            font-size: 50px;
            margin-bottom: 15px;
            display: inline-block;
        }

        /* حركة ظهور ناعمة للرسالة */
        @keyframes fadeIn {
            from { opacity: 0; transform: scale(0.9); }
            to { opacity: 1; transform: scale(1); }
        }
    </style>
</head>
<body>

    <div class="container">
        <!-- القسم الأول: محتوى صفحة الهبوط الأساسي -->
        <div id="main-content">
            <span class="badge">عرض لعام 2026! 🔥</span>
            <h1>احترف البرمجة من الصفر إلى أول وظيفة</h1>
            <p>انضم إلينا اليوم واحصل على خصم 50% على كورس الويب الشامل. سجل إيميلك لحجز مكانك.</p>
            
            <form id="landing-form">
                <input type="email" id="user-email" placeholder="أدخل بريدك الإلكتروني هنا" required>
                <button type="submit">احجز مقعدك مجاناً الآن 🚀</button>
            </form>
        </div>

        <!-- القسم الثاني: رسالة النجاح المحتوية على المفاجأة (تظهر بعد الإدخال) -->
        <div id="success-message" class="success-box">
            <span class="success-icon">🎉👏</span>
            <h2>تم التسجيل بنجاح!</h2>
            <p>شكراً لاهتمامك. تم إرسال رابط كتاب <strong>"أساسيات البرمجة للمبتدئين"</strong> مجاناً إلى إيميلك: <br><strong id="display-email" style="color:#3498db;"></strong></p>
            <p style="font-size: 13px; color:#95a5a6;">تفقد صندوق الوارد أو الـ Spam خلال دقيقتين.</p>
        </div>
    </div>

    <!-- كود الجافا سكريبت المسؤول عن التفاعل وتحويل الأشكال -->
    <script>
        // 1. نمسك العناصر من الـ HTML ونحفظها في متغيرات
        const form = document.getElementById('landing-form');
        const mainContent = document.getElementById('main-content');
        const successMessage = document.getElementById('success-message');
        const displayEmail = document.getElementById('display-email');
        const userEmailInput = document.getElementById('user-email');

        // 2. نراقب اللحظة التي يضغط فيها المستخدم على زر الإرسال
        form.addEventListener('submit', function(event) {
            // نمنع الصفحة من عمل Refresh وضياع البيانات
            event.preventDefault(); 
            
            // نأخذ الإيميل الذي كتبه المستخدم ونضعه داخل رسالة النجاح
            displayEmail.textContent = userEmailInput.value;

            // نُخفي صندوق الإدخال الأساسي
            mainContent.style.display = 'none';
            
            // نُظهر رسالة النجاح المتحركة
            successMessage.style.display = 'block';
        });
    </script>

</body>
</html>
